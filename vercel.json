{
  "buildCommand": "cd frontend && npx --yes pnpm@9.15.9 run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npx --yes pnpm@9.15.9 install --frozen-lockfile",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

