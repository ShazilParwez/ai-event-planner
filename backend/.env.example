# ==============================================================================
# Backend Specific Environment Configuration
# ==============================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=dev-insecure-secret-key-32-characters-minimum-for-validation
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database
DATABASE_URL=sqlite:///./event_planner.db

# Google Gemini GenAI Settings
# Set USE_MOCK_AI=false and provide GEMINI_API_KEY to enable live Gemini API calls
USE_MOCK_AI=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=3
AI_CIRCUIT_BREAKER_FAILURES=5
AI_CIRCUIT_BREAKER_RESET_SECONDS=60
