# ==============================================================================
# AI Event Planner - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables for your target environment.
# NEVER commit production .env files or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global Application Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="AI Event Planner"
# Runtime environment: development, staging, production
# In 'production':
#   - Strong SECRET_KEY (min 32 chars) is strictly enforced at startup
#   - Cookies are marked Secure=True and HttpOnly=True
#   - Refresh token is omitted from JSON responses to block JavaScript access
#   - Interactive OpenAPI documentation (/docs, /redoc) is disabled
ENVIRONMENT=production
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Reverse Proxy Gateway & Public Exposure
# ------------------------------------------------------------------------------
# Port exposed on the host machine by the Nginx reverse proxy gateway
GATEWAY_PORT=80
# Backend host and port (internal ASGI server)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# 3. Security, Authentication & CORS
# ------------------------------------------------------------------------------
# Cryptographically strong secret key for JWT signing and session protection.
# MUST be at least 32 random characters in production!
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-cryptographically-secure-random-32-char-string-for-prod

# Explicitly allowed origins for CORS (no wildcards allowed when credentials=true)
# Include your production domain(s)
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80

# ------------------------------------------------------------------------------
# 4. Database Infrastructure
# ------------------------------------------------------------------------------
# PostgreSQL credentials for Docker Compose container
POSTGRES_DB=event_planner_db
POSTGRES_USER=event_user
POSTGRES_PASSWORD=replace-with-secure-postgres-password-in-production

# Production connection string using modern psycopg 3 dialect:
DATABASE_URL=postgresql+psycopg://event_user:replace-with-secure-postgres-password-in-production@db:5432/event_planner_db

# For standalone local development with SQLite (without Docker):
# DATABASE_URL=sqlite:///./event_planner.db

# Production Connection Pool Tuning (QueuePool)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 5. Google Gemini AI & Resilience Configuration
# ------------------------------------------------------------------------------
# When USE_MOCK_AI=true, the backend uses deterministic mock responses (offline/test mode)
# In production, set USE_MOCK_AI=false and provide a valid GEMINI_API_KEY
USE_MOCK_AI=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=3
AI_CIRCUIT_BREAKER_FAILURES=5
AI_CIRCUIT_BREAKER_RESET_SECONDS=60

# ------------------------------------------------------------------------------
# 6. Frontend Build & Client Configuration
# ------------------------------------------------------------------------------
# In production with Nginx same-origin reverse proxy, use relative /api/v1
VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE="AI Event Planner"
VITE_APP_ENV=production
